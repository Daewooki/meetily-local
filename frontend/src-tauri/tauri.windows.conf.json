{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "templates/*.json": "templates/",
      "licenses/*": "licenses/",
      "binaries/onnxruntime/*.dll": ".",
      "binaries/onnxruntime/*LICENSE*": "licenses/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Korean"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
